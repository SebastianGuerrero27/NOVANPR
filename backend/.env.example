# Configuración del Backend ANPR
PORT=5000
NODE_ENV=development

# Base de Datos SQL Server
DB_USER=sa
DB_PASSWORD=<contraseña de SQL Server>
DB_SERVER=db
DB_PORT=1433
DB_NAME=ANPR_ECU911

# JWT Secret
JWT_SECRET=<cadena aleatoria de 48+ caracteres>

# Directorio de Media
MEDIA_DIR=/app/media

# URL del Servicio ANPR
ANPR_SERVICE_URL=http://anpr:8000

# Configuración Docker
DOCKER_CONTAINER=true

# Configuración Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=info