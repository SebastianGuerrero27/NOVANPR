# Configuración del Backend ANPR
PORT=5000
NODE_ENV=development

# Base de Datos SQL Server
DB_USER=sa
DB_PASSWORD=<contraseña de SQL Server>
DB_SERVER=db
DB_PORT=1433
DB_NAME=ANPR_ECU911

# JWT Secret
JWT_SECRET=<cadena aleatoria de 48+ caracteres>

# Directorio de Media
MEDIA_DIR=/app/media

# URL del Servicio ANPR
ANPR_SERVICE_URL=http://anpr:8000

# Configuración Docker
DOCKER_CONTAINER=true

# Configuración Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
# Segundo factor: si una placa AUTORIZADA aparece en un vehículo de otra marca/color, enviarla a revisión
VERIFICAR_VEHICULO_AUTORIZADOS=true

# Consulta de propietario: solo con convenio oficial (DINARDAP / ANT). "deshabilitado" u "oficial"
PROPIETARIO_PROVEEDOR=deshabilitado
PROPIETARIO_API_URL=
PROPIETARIO_API_CREDENCIAL=
PROPIETARIO_LIMITE_HORA=20

# --- Cuentas y seguridad ---
ANPR_SERVICE_TOKEN=<igual al del servicio ANPR>
JWT_EXPIRATION=8h
BCRYPT_ROUNDS=12
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15
REGISTRO_PUBLICO_HABILITADO=true
ALLOWED_EMAIL_DOMAINS=ecu911.gob.ec
FRONTEND_URL=http://localhost:3000
# --- Correo SMTP (sin usuario/contraseña, los correos se muestran en la consola) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Solo para servidores SMTP internos con certificado autofirmado
SMTP_TLS_INSECURE=false

# --- Centro de notificaciones (docs/NOTIFICACIONES.md) ---
# Claves VAPID de Web Push. Vacías: el backend genera un par la primera vez y lo guarda en la
# tabla ClavesServicio. Para fijarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:anpr@ecu911.gob.ec
# Adaptador Redis de Socket.IO (varias instancias del backend comparten las emisiones)
SOCKET_REDIS_ADAPTER=true
# Valores iniciales (también editables en Configuración › Notificaciones)
NOTIF_ESCALAMIENTO_SEGUNDOS=90
NOTIF_ESCALAMIENTO_CORREO=false
NOTIF_REINCIDENCIA_UMBRAL=3
NOTIF_PUSH_HABILITADO=true
NOTIF_RETENCION_DIAS=90
# false desactiva el escalamiento, el resumen diario y la depuración en esta instancia
TAREAS_PROGRAMADAS=true
