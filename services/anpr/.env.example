# ==============================================================================
# ECU 911 ANPR Microservice — Configuración de Entorno
# ==============================================================================
# Copiar este archivo como .env y ajustar los valores según el entorno.
#   cp .env.example .env
# ==============================================================================

# --- Servidor FastAPI (el puerto lo fija el comando uvicorn: 8000) ---
LOG_LEVEL=INFO
# Opciones de LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Fuente de video ---
# La única entrada es la cámara RTSP que el administrador registra en el sistema web: el backend
# la asigna al motor a través de MediaMTX al arrancar y al cambiarla en Monitoreo. Dejar vacío.
# Solo para ejecutar el motor aislado (sin backend) se puede indicar una URL de prueba; nunca
# credenciales reales en este archivo.
RTSP_URL=

# --- Detector de placas (models/MODEL_CARD.md) ---
PLATE_MODEL_PATH=models/license_plate_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.30
# Umbral alto de ByteTrack (crea los seguimientos; el bajo es el 25 %): 0.22 da más recall con placas
# ecuatorianas, que el detector puntúa más bajo (models/MODEL_CARD.md)
PLATE_CONFIDENCE_THRESHOLD=0.22

# --- Modelos cuantizados ---
# Para usar un modelo cuantizado (scripts/quantize_yolo.py), apunte PLATE_MODEL_PATH al archivo
# generado y valídelo antes (scripts/evaluate_detectors.py).

# --- Motor OCR ---
# Opciones: "plate" (recomendado: fast-plate-ocr sin respaldos), "hybrid", "paddleocr", "easyocr"
OCR_ENGINE=plate
# Modelo del hub si no existe el afinado con placas ecuatorianas (scripts/train_ocr.py)
PLATE_OCR_HUB_MODEL=cct-s-v2-global-model
PLATE_OCR_ONNX_PATH=models/ocr/cct_s_v2_ecuador.onnx
PLATE_OCR_CONFIG_PATH=models/ocr/cct_s_v2_ecuador_plate_config.yaml
PLATE_OCR_PREPROCESS=false

# --- Verificador PP-OCRv6 (segunda lectura de la mejor foto, fase asíncrona) ---
OCR_VERIFIER_ENABLED=true
# tiny | small | medium   ·   openvino | onnxruntime
OCR_VERIFIER_MODEL=medium
OCR_VERIFIER_ENGINE=openvino
OCR_VERIFIER_MAX_MS=2000
# Tiempo máximo desde la foto del paso hasta su registro (0: esperar a todas las etapas). El segundo
# OCR y los atributos del vehículo que lleguen después se envían como reevaluación del paso.
REGISTRO_MAX_MS=1000
OCR_VERIFIER_VOTE_WEIGHT=2.0

# --- Hilos por motor de inferencia (CPU) ---
# PyTorch (detector y atributos del vehículo), ONNX Runtime (OCR rápido) y OpenVINO (verificador)
# usan por omisión todos los núcleos; como corren a la vez, se reparten hilos fijos para no
# sobresuscribir la CPU (docs/METODO_VERIFICACION_LECTURA.md §3.2).
TORCH_THREADS=4
OCR_THREADS=2
OCR_VERIFIER_THREADS=4

# --- Detector: "yolo" (YOLOv8/YOLO11/YOLO26) o "rfdetr" (PLATE_MODEL_PATH apunta al .pth) ---
DETECTOR_BACKEND=yolo
OCR_CONFIDENCE_THRESHOLD=0.30
# Para Tesseract en Windows, especificar la ruta al ejecutable:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Compuerta de movimiento (docs/METODO_VERIFICACION_LECTURA.md §2.4) ---
# El detector de placas solo se ejecuta si desde la última inferencia cambió al menos
# MOTION_GATE_MIN_FRACTION del área (o de la región de interés); si no, la última detección
# sigue valiendo, con una inferencia de control cada MOTION_GATE_MAX_SKIP cuadros.
# false = detector en cada cuadro.
MOTION_GATE_ENABLED=true
MOTION_GATE_MIN_FRACTION=0.002
MOTION_GATE_MAX_SKIP=5

# Con área de detección (región de interés), el detector analiza solo su recorte: más píxeles por
# placa a la misma resolución de inferencia (en la prueba de Open Images, recall de placas pequeñas
# 37,9 % -> 47,5 %; docs/METODO_VERIFICACION_LECTURA.md §3.3). false = cuadro completo.
ROI_CROP_INFERENCE=true

# --- Modo de Depuración Visual ---
# Activa la visualización de bounding boxes, tracking IDs y texto OCR
DEBUG_VISUAL=true
# En Docker se ignora cv2.imshow() automáticamente; el endpoint MJPEG siempre está disponible.

# --- Comunicación con Backend Node.js ---
BACKEND_URL=http://localhost:5000

# --- Base de Datos / Cámara ---
# ID de la cámara en la tabla Camaras de SQL Server
CAMERA_ID=1

# --- Almacenamiento de Imágenes ---
MEDIA_DIR=./media

# --- Rectificación aprendida (YOLO26n-pose, 4 esquinas); si no existe el archivo, heurística ---
PLATE_RECTIFIER_PATH=models/plate_rectifier.pt
PLATE_RECTIFIER_MIN_KPT_CONF=0.5

# --- Atributos del vehículo (segundo factor): YOLO26n COCO + CLIP zero-shot ---
VEHICLE_ATTR_ENABLED=true
VEHICLE_DETECTOR_PATH=yolo26n.pt
VEHICLE_CLIP_MODEL=ViT-B-32
VEHICLE_CLIP_PRETRAINED=laion2b_s34b_b79k
VEHICLE_ATTR_MIN_CONF=0.35

# --- Token compartido con el backend (rutas máquina a máquina). Igual a ANPR_SERVICE_TOKEN del backend ---
ANPR_SERVICE_TOKEN=
