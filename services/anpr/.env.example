# ==============================================================================
# ECU 911 ANPR Microservice — Configuración de Entorno
# ==============================================================================
# Copiar este archivo como .env y ajustar los valores según el entorno.
#   cp .env.example .env
# ==============================================================================

# --- Servidor FastAPI ---
PORT=8000
LOG_LEVEL=INFO
# Opciones de LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Fuente de Video ---
# Opciones: "webcam" (Etapa 1 — laptop) o "rtsp" (Etapa 2 — cámara IP)
CAMERA_SOURCE=webcam

# Webcam: índice del dispositivo de captura (0 = cámara integrada/principal)
WEBCAM_INDEX=0

# RTSP: URL completa de la cámara IP Hikvision
# NUNCA hardcodees credenciales reales aquí. Usa este archivo solo como plantilla.
RTSP_URL=rtsp://<USUARIO>:<CONTRASEÑA>@<IP_CAMARA>:<PUERTO>/<RUTA_STREAM>
# Ejemplo Hikvision típico:
# RTSP_URL=rtsp://admin:MiPassword@192.168.1.64:554/h265/ch1/main/av_stream

# --- Resiliencia RTSP ---
RTSP_RECONNECT_DELAY_SEC=5
RTSP_MAX_RECONNECT_DELAY_SEC=120
RTSP_CONNECTION_TIMEOUT_SEC=10
RTSP_MAX_RETRIES=5

# --- Resolución de Captura ---
# Se aplica tanto a webcam como a RTSP (resize del frame capturado)
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# --- Modelo YOLO (Etapa 1: Vehículos / Etapa 2: Placas Especializado) ---
YOLO_MODEL_PATH=yolo11n.pt
PLATE_MODEL_PATH=models/license_plate_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.30
PLATE_CONFIDENCE_THRESHOLD=0.35
# Clases COCO para vehículos (solo aplica con modelo genérico):
# 2=car, 3=motorcycle, 5=bus, 7=truck
YOLO_VEHICLE_CLASSES=2,3,5,7

# --- Modelos cuantizados ---
# Para usar un modelo cuantizado (scripts/quantize_yolo.py), apunte YOLO_MODEL_PATH o
# PLATE_MODEL_PATH al archivo generado (docs/MODEL_QUANTIZATION.md).

# --- Motor OCR ---
# Opciones: "plate" (recomendado: fast-plate-ocr sin respaldos), "hybrid", "paddleocr", "easyocr"
OCR_ENGINE=plate
# Modelo del hub si no existe el afinado con placas ecuatorianas (scripts/train_ocr.py)
PLATE_OCR_HUB_MODEL=cct-s-v2-global-model
PLATE_OCR_ONNX_PATH=models/ocr/cct_s_v2_ecuador.onnx
PLATE_OCR_CONFIG_PATH=models/ocr/cct_s_v2_ecuador_plate_config.yaml
PLATE_OCR_PREPROCESS=false

# --- Verificador PP-OCRv6 (segunda lectura de la mejor foto, fase asíncrona) ---
OCR_VERIFIER_ENABLED=true
# tiny | small | medium   ·   openvino | onnxruntime
OCR_VERIFIER_MODEL=medium
OCR_VERIFIER_ENGINE=openvino
OCR_VERIFIER_MAX_MS=2000
OCR_VERIFIER_VOTE_WEIGHT=2.0

# --- Detector: "yolo" (YOLOv8/YOLO11/YOLO26) o "rfdetr" (PLATE_MODEL_PATH apunta al .pth) ---
DETECTOR_BACKEND=yolo
OCR_CONFIDENCE_THRESHOLD=0.30
# Para Tesseract en Windows, especificar la ruta al ejecutable:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Tracking y Deduplicación ---
# Cooldown en segundos: tiempo mínimo entre re-emisiones de la misma placa/tracking ID
DETECTION_COOLDOWN_SEC=15
# Cada cuántos frames se ejecuta la inferencia (1 = todos, 5 = cada 5 frames)
FRAME_SKIP=5

# --- Modo de Depuración Visual ---
# Activa la visualización de bounding boxes, tracking IDs y texto OCR
DEBUG_VISUAL=true
# En Docker se ignora cv2.imshow() automáticamente; el endpoint MJPEG siempre está disponible.

# --- Comunicación con Backend Node.js ---
BACKEND_URL=http://localhost:5000
# URL del servidor Socket.IO del backend (para emisión directa al frontend)
BACKEND_SOCKETIO_URL=http://localhost:5000

# --- Base de Datos / Cámara ---
# ID de la cámara en la tabla Camaras de SQL Server
CAMERA_ID=1

# --- Almacenamiento de Imágenes ---
MEDIA_DIR=./media

# --- Rectificación aprendida (YOLO26n-pose, 4 esquinas); si no existe el archivo, heurística ---
PLATE_RECTIFIER_PATH=models/plate_rectifier.pt
PLATE_RECTIFIER_MIN_KPT_CONF=0.5

# --- Atributos del vehículo (segundo factor): YOLO26n COCO + CLIP zero-shot ---
VEHICLE_ATTR_ENABLED=true
VEHICLE_DETECTOR_PATH=yolo26n.pt
VEHICLE_CLIP_MODEL=ViT-B-32
VEHICLE_CLIP_PRETRAINED=laion2b_s34b_b79k
VEHICLE_ATTR_MIN_CONF=0.35

# --- Token compartido con el backend (rutas máquina a máquina). Igual a ANPR_SERVICE_TOKEN del backend ---
ANPR_SERVICE_TOKEN=
