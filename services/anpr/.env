# ==============================================================================
# ECU 911 ANPR Microservice — Configuración de Entorno
# ==============================================================================

# --- Servidor FastAPI ---
PORT=8000
LOG_LEVEL=INFO

# --- Fuente de Video ---
# Opciones: "webcam" (Cámara integrada / USB del operador), "rtsp" (Cámara IP Hikvision)
CAMERA_SOURCE=webcam
WEBCAM_INDEX=0
# Consumir desde MediaMTX (H.265+ passthrough de la Hikvision DS-2CD1123G0E-I)
RTSP_URL=rtsp://localhost:8554/camara_raw
# Enlace directo de respaldo a la cámara física:
# RTSP_URL=rtsp://admin:Ecu911Ambato@10.126.9.104:554/Streaming/Channels/101

# --- Resiliencia RTSP ---
RTSP_RECONNECT_DELAY_SEC=5
RTSP_MAX_RECONNECT_DELAY_SEC=120
RTSP_CONNECTION_TIMEOUT_SEC=10
RTSP_MAX_RETRIES=5

# --- Resolución de Captura ---
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# --- Modelo YOLO (Etapa 1: Vehículos / Etapa 2: Placas Especializado) ---
YOLO_MODEL_PATH=yolo11n.pt
PLATE_MODEL_PATH=models/license_plate_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.28
PLATE_CONFIDENCE_THRESHOLD=0.28
YOLO_VEHICLE_CLASSES=2,3,5,7

# --- Motor OCR ---
# Opciones: "paddleocr" (Ultra-rápido ~20ms ONNX), "hybrid", "easyocr"
OCR_ENGINE=paddleocr
OCR_CONFIDENCE_THRESHOLD=0.25
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Tracking y Deduplicación ---
DETECTION_COOLDOWN_SEC=10
FRAME_SKIP=1
INFERENCE_THROTTLE_MS=0

# --- Modo de Depuración Visual ---
DEBUG_VISUAL=true

# --- Comunicación con Backend Node.js ---
BACKEND_URL=http://localhost:5000
BACKEND_SOCKETIO_URL=http://localhost:5000
SYNC_ENDPOINT=/api/detecciones/sync
LEGACY_SYNC_ENABLED=true

# --- Base de Datos / Cámara ---
CAMERA_ID=1

# --- Almacenamiento de Imágenes ---
MEDIA_DIR=./media
