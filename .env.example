# Copiar como .env en la raíz del proyecto (docker compose lo lee automáticamente).
MSSQL_SA_PASSWORD=<contraseña fuerte de SQL Server>
JWT_SECRET=<cadena aleatoria de 48+ caracteres, ej: python -c "import secrets;print(secrets.token_urlsafe(48))">
# Clave AES-256 de las contraseñas RTSP de las cámaras (32 bytes en base64): openssl rand -base64 32
# Guárdela con los demás secretos: si se pierde, hay que volver a escribir las contraseñas de las cámaras.
CAMARAS_CLAVE_CIFRADO=<base64 de 32 bytes>
# Solo al rotar la clave: la anterior (o varias, separadas por coma). Tras un arranque ya se puede quitar.
CAMARAS_CLAVE_CIFRADO_ANTERIOR=
GRAFANA_ADMIN_PASSWORD=<contraseña de Grafana>
# Token compartido backend <-> servicio ANPR: python -c "import secrets;print(secrets.token_urlsafe(32))"
ANPR_SERVICE_TOKEN=<token aleatorio>
# Correo SMTP (sin SMTP_USER/SMTP_PASSWORD los correos se muestran en la consola del backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dominios de correo aceptados en el registro (separados por coma)
ALLOWED_EMAIL_DOMAINS=ecu911.gob.ec
FRONTEND_URL=http://localhost:3000

# Video en vivo (WebRTC por MediaMTX)
# IP del equipo anunciadas al navegador; agregue la IP de la LAN para ver el video desde otros equipos
WEBRTC_HOSTS=127.0.0.1
# URL publica de MediaMTX y del motor ANPR vistas por el navegador
WEBRTC_PUBLIC_URL=http://localhost:8889
ANPR_PUBLIC_URL=http://localhost:8000

# Notificaciones Web Push (opcional). Vacías: el backend genera y guarda un par VAPID.
# Las notificaciones push del navegador requieren https o http://localhost.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:anpr@ecu911.gob.ec
